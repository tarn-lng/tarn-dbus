// 0.1 API kept during 0.2, now a thin layer over the native connection.
// New code should use src/connection, src/message and src/value directly.
import "src/connection"
import "src/error"
import "src/message"
import "src/names"
import "src/value"

pub struct Error { pub name string
    pub message string }
fn make_error(name &string, text &string) Error { return Error{name: name.clone(), message: text.clone()} }
fn from_native(failure error.Error) Error { return Error{name: failure.name, message: failure.message} }

/// 0.1 value model. String, object path and signature replies share `Text`;
/// byte, int16/uint16, int64 and double replies are UnsupportedType here
/// (the native value model in src/value supports them).
pub enum Value {
    Text(string)
    Bool(bool)
    U32(u32)
    I32(i32)
    U64(u64)
    List(Vec<Value>)
    Tuple(Vec<Value>)
    Entry(Vec<Value>)
    Variant(Vec<Value>)
}

/// Opaque borrowed session authority, only available inside with_session.
pub struct Connection { native connection.Connection }

/// Owned message data. Type: 1 call, 2 return, 3 error, 4 signal.
pub struct Message {
    pub kind i32
    pub path string
    pub interface_name string
    pub member string
    pub sender string
    pub values Vec<Value>
}

/// Private connection, closed on every ordinary callback result, including Err.
pub fn with_session(work fn(&mut Connection) Result<void, Error>) Result<void, Error> {
    path := try connection.session_path().map_err(fn(failure error.Error) Error { return from_native(failure) })
    native := try connection.open(&path).map_err(fn(failure error.Error) Error { return from_native(failure) })
    var bus = Connection{native: native}
    result := work(&mut bus)
    bus.native.close()
    return result
}

fn convert(item &value.Value) Result<Value, Error> {
    match item {
        value.Value.Text(s) => { return Ok(Value.Text(s.clone())) }
        value.Value.Path(s) => { return Ok(Value.Text(s.clone())) }
        value.Value.Sig(s) => { return Ok(Value.Text(s.clone())) }
        value.Value.Bool(flag) => { return Ok(Value.Bool(flag)) }
        value.Value.U32(raw) => { return Ok(Value.U32(raw)) }
        value.Value.I32(raw) => { return Ok(Value.I32(raw)) }
        value.Value.U64(raw) => { return Ok(Value.U64(raw)) }
        value.Value.Array(list) => { return Ok(Value.List(try convert_all(list.items.as_slice()))) }
        value.Value.Struct(fields) => { return Ok(Value.Tuple(try convert_all(fields.as_slice()))) }
        value.Value.Variant(held) => { return Ok(Value.Variant(try convert_all(held.inner.as_slice()))) }
        value.Value.Dict(map) => {
            var entries: Vec<Value> = Vec.new()
            for entry in map.entries.as_slice() {
                var pair: Vec<Value> = Vec.new()
                pair.push(try convert(&entry.key))
                pair.push(try convert(&entry.value))
                entries.push(Value.Entry(pair))
            }
            return Ok(Value.List(entries))
        }
        _ => { return Err(make_error("tarn.dbus.UnsupportedType", "Reply contains a type not supported by the 0.1 value model")) }
    }
}
fn convert_all(items &[]value.Value) Result<Vec<Value>, Error> {
    var out: Vec<Value> = Vec.new()
    for item in items { out.push(try convert(item)) }
    return Ok(out)
}

/// Calls a method with string arguments; timeout 1..60000 ms.
pub fn Connection.call_strings(&mut self, destination &string, path &string, interface_name &string, member &string, arguments &Vec<string>, timeout_ms i32) Result<Vec<Value>, Error> {
    if timeout_ms <= 0 || timeout_ms > 60000 { return Err(make_error("tarn.dbus.InvalidArgument", "Timeout must be 1..60000 milliseconds")) }
    if !names.valid_bus_name(destination) || !names.valid_path(path) || !names.valid_interface(interface_name) || !names.valid_member(member) {
        return Err(make_error("tarn.dbus.InvalidArgument", "Invalid bus name, object path, interface_name or member"))
    }
    var body: Vec<value.Value> = Vec.new()
    for argument in arguments.as_slice() {
        for c in argument.bytes() { if c == 0 { return Err(make_error("tarn.dbus.InvalidArgument", "D-Bus strings cannot contain NUL")) } }
        body.push(value.text(argument))
    }
    reply := try self.native.call(message.call(destination, path, interface_name, member, body), timeout_ms).map_err(fn(failure error.Error) Error { return from_native(failure) })
    return convert_all(reply.body.as_slice())
}
pub fn Connection.list_names(&mut self) Result<Vec<string>, Error> { return self.native.list_names().map_err(fn(failure error.Error) Error { return from_native(failure) }) }
pub fn Connection.name_owner(&mut self, name &string) Result<string, Error> { return self.native.name_owner(name).map_err(fn(failure error.Error) Error { return from_native(failure) }) }
pub fn Connection.request_name(&mut self, name &string) Result<void, Error> { return self.native.request_name(name).map_err(fn(failure error.Error) Error { return from_native(failure) }) }
pub fn Connection.add_match(&mut self, rule &string) Result<void, Error> { return self.native.add_match(rule).map_err(fn(failure error.Error) Error { return from_native(failure) }) }
pub fn Connection.remove_match(&mut self, rule &string) Result<void, Error> { return self.native.remove_match(rule).map_err(fn(failure error.Error) Error { return from_native(failure) }) }

/// At most one incoming message, waiting 0..60000 ms.
pub fn Connection.receive(&mut self, timeout_ms i32) Result<Option<Message>, Error> {
    if timeout_ms < 0 || timeout_ms > 60000 { return Err(make_error("tarn.dbus.InvalidArgument", "Receive wait must be 0..60000 milliseconds")) }
    match try self.native.receive(timeout_ms).map_err(fn(failure error.Error) Error { return from_native(failure) }) {
        Some(item) => {
            values := try convert_all(item.body.as_slice())
            return Ok(Some(Message{kind: i32(item.kind), path: item.path, interface_name: item.interface_name,
                member: item.member, sender: item.sender, values: values}))
        }
        None => { return Ok(None) }
    }
}
/// Queues an empty broadcast signal.
pub fn Connection.signal(&mut self, path &string, interface_name &string, member &string) Result<void, Error> {
    if !names.valid_path(path) || !names.valid_interface(interface_name) || !names.valid_member(member) {
        return Err(make_error("tarn.dbus.InvalidArgument", "Invalid signal path, interface or member"))
    }
    return self.native.signal(path, interface_name, member, Vec.new(), &"").map_err(fn(failure error.Error) Error { return from_native(failure) })
}
